<script>
function calculateSeverance() {
  var pay = parseFloat(document.getElementById('sev-pay').value) || 0;
  var years = parseFloat(document.getElementById('sev-years').value) || 0;
  var months = parseInt(document.getElementById('sev-months').value) || 0;
  var age = parseFloat(document.getElementById('sev-age').value) || 0;
  var prior = parseFloat(document.getElementById('sev-prior').value) || 0;

  if (pay <= 0 || years < 0) {
    alert('Please enter your annual basic pay and years of creditable service.');
    return;
  }

  var weekly = pay / 52;
  // Partial years credited per full three-month quarter (0, 3, 6, 9 months)
  var serviceCredit = years + (Math.floor(Math.min(months, 11) / 3) * 0.25);
  // Base: 1 week/yr for first 10, 2 weeks/yr after 10
  var baseWeeks = serviceCredit <= 10 ? serviceCredit : 10 + (serviceCredit - 10) * 2;
  // Age adjustment: 2.5% per full quarter over age 40
  var adjPct = 0;
  if (age > 40) { adjPct = Math.floor((age - 40) * 4) * 0.025; }
  var grossWeeks = baseWeeks * (1 + adjPct);
  // 52-week lifetime cap (includes prior severance)
  var capRemaining = Math.max(0, 52 - prior);
  var capped = Math.min(grossWeeks, capRemaining);
  var gross = Math.round(capped * weekly);

  document.getElementById('sev-result-amount').textContent = '$' + gross.toLocaleString();
  document.getElementById('sev-weeks').textContent = (Math.round(capped * 10) / 10) + ' weeks of pay';

  var detail = 'Weekly pay $' + Math.round(weekly).toLocaleString()
    + ' · base ' + (Math.round(baseWeeks * 10) / 10) + ' wks';
  if (adjPct > 0) detail += ' · age adjustment +' + Math.round(adjPct * 100) + '%';
  if (grossWeeks > capRemaining) detail += ' · capped at the 52-week maximum';
  document.getElementById('sev-detail').textContent = detail;

  var box = document.getElementById('sev-results');
  box.style.display = 'block';
  box.scrollIntoView({ behavior: 'smooth', block: 'center' });
}
</script>
